{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "within_contract",
    "compatibility",
    "blocking",
    "non_blocking",
    "summary"
  ],
  "properties": {
    "within_contract": {"type": "boolean"},
    "compatibility": {
      "type": "string",
      "enum": ["compatible", "breaking", "unknown"]
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "summary"],
        "properties": {
          "path": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    },
    "non_blocking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "summary"],
        "properties": {
          "path": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"}
  }
}
